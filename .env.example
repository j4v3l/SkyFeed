# Discord identifiers are placeholders. Enter real values only in your local
# untracked .env file.
SKYFEED_DISCORD_TOKEN_FILE=/run/secrets/discord_token
SKYFEED_DISCORD_APPLICATION_ID=REPLACE_WITH_APPLICATION_ID
SKYFEED_DISCORD_GUILD_ID=REPLACE_WITH_DEVELOPMENT_GUILD_ID
SKYFEED_DISCORD_GLOBAL_COMMANDS=false

# Prefer a stable LAN IP or ordinary LAN DNS name inside Docker.
SKYFEED_ADSB_BASE_URL=http://192.168.x.y/data
SKYFEED_AIRCRAFT_POLL=1s
SKYFEED_METADATA_POLL=30s

SKYFEED_DATABASE_PATH=/var/lib/skyfeed/skyfeed.db

# Enrichment is opt-in. Read the ADSBDB data-use notice before enabling it.
SKYFEED_ADSBDB_ENABLED=false
SKYFEED_ADSBDB_ROUTE_ENABLED=false
SKYFEED_ADSBDB_BASE_URL=https://api.adsbdb.com/v0
SKYFEED_ADSBDB_TIMEOUT=2s
SKYFEED_ADSBDB_WORKERS=2
SKYFEED_ADSBDB_AIRCRAFT_TTL=336h
SKYFEED_ADSBDB_ROUTE_TTL=8h
SKYFEED_ADSBDB_NOT_FOUND_TTL=3h
SKYFEED_ADSBDB_ERROR_TTL=30s
SKYFEED_ADSBDB_STALE_TTL=24h

SKYFEED_DASHBOARD_INTERVAL=15s
SKYFEED_HEALTH_ADDR=0.0.0.0:9090
SKYFEED_PPROF_ADDR=
SKYFEED_LOG_LEVEL=info
SKYFEED_LOG_FORMAT=json
SKYFEED_TIMEZONE=UTC
